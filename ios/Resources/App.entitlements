<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Право поднимать туннель. Выдаётся только платному аккаунту
         разработчика Apple; в бесплатном профиле его нет, и приложение
         соберётся, но VPN не запустится. -->
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>packet-tunnel-provider</string>
    </array>

    <!-- Общая группа: без неё расширение туннеля не увидит ни ключей,
         ни правил, потому что это отдельный процесс. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.ai.theeva.vpn</string>
    </array>
</dict>
</plist>
