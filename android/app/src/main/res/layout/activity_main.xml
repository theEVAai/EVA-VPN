<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="VPN.THEEVA.AI"
        android:textColor="@color/cream"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/heart"
        android:layout_width="190dp"
        android:layout_height="178dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@string/action_connect"
        android:src="@drawable/ic_heart" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:text="@string/status_stopped"
        android:textColor="@color/cream_dim"
        android:textSize="19sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/status_no_key"
        android:textColor="@color/cream_dim"
        android:textSize="12sp"
        android:fontFamily="monospace" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnKeys"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/menu_keys"
            android:textColor="@color/cream"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btnRules"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/menu_rules"
            android:textColor="@color/cream"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btnApps"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/menu_apps"
            android:textColor="@color/cream"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </LinearLayout>
</LinearLayout>
